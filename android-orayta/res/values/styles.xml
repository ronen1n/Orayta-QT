<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen theme - shown during app startup -->
    <style name="SplashTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Disable window animation for instant appearance -->
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    
    <!-- Main app theme - Force light theme regardless of system setting -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Force light background and dark text -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">#666666</item>
        <!-- Prevent system dark mode from affecting the app -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
    
    <!-- Fallback theme for older Android versions -->
    <style name="EdgeToEdgeTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Basic transparent status bar for older versions -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
    </style>
</resources>